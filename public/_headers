/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-YQdwszUyjwVmrEvo6aSHUIfGX67FkEYYCuTlRds/PfU=' 'report-sample'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types app-jsonld app-sw;

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/subject/*
  Cache-Control: no-cache

/unit/*
  Cache-Control: no-cache

/legal
  Cache-Control: no-cache

/reference
  Cache-Control: no-cache

/robots.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Content-Type
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/unit/*.md
  ! Content-Type
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/favicon.ico
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

/favicon.png
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

/favicon.svg
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

/icon-192.png
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

/icon-512.png
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

/og-image.png
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400
