{
  "name": "dobokunomanabiya",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/legal",
      "/subject/*",
      "/unit/*",
      "/googlee9c930fab0503349.html",
      "/.well-known/*"
    ]
  },
  "previews": {}
}
